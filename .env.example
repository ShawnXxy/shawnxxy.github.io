# Environment Variables Example
# Copy this file to .env and fill in your actual values

# GitHub API token for language and showcase data generation
git_token=your_github_token_here

# Copilot CLI token with Copilot Requests permission, used only by the Node generator
COPILOT_GITHUB_TOKEN=your_copilot_requests_token_here

# Azure Maps Subscription Key
# Get this from Azure Portal → Azure Maps Account → Authentication
AZURE_MAPS_SUBSCRIPTION_KEY=your_azure_maps_key_here
